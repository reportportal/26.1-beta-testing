# ReportPortal upload config for rp_stream_upload.py
# Copy to .env and fill in
RP_URL=https://tms.beta.reportportal.io
# Organization slug only (part before the dot). Script appends:
#   Stream A -> {RP_PROJECT}.stream-a
#   Stream B -> {RP_PROJECT}.stream-b
RP_PROJECT=your_org_slug
RP_API_KEY=your_api_key
